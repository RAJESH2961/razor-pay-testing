# Copy to .env and fill in. Never commit .env.
APP_ENV=development

# Postgres (same names as your existing projects)
PG_USER=webvoid_dev
PG_PASS=change-me
PG_HOST=your-instance.xxxxxx.ap-south-1.rds.amazonaws.com
PG_PORT=5432
DB_NAME=postgres
DB_SCHEMA=payment_test
# require for RDS; use disable only for a local Postgres
PG_SSLMODE=require

# Razorpay: Dashboard > Account & Settings > API Keys (rzp_test_... in test mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=change-me
# You invent this value, then paste the same value in Dashboard > Webhooks.
# It is NOT the API key secret.
RAZORPAY_WEBHOOK_SECRET=change-me-long-random-string

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=60

# Comma separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Password for the demo users created by scripts/seed.py
SEED_USER_PASSWORD=change-me-too
